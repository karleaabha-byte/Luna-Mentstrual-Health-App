# Copy to .env and add your own hosted OpenAI-compatible API credentials.
LLM_API_KEY=replace_me
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest
# Other OpenAI-compatible options: Groq https://api.groq.com/openai/v1 | OpenAI https://api.openai.com/v1
# Semantic search downloads a small ONNX MiniLM model (~80 MB) on first run.
# 0.0-0.3 is right for factual health answers grounded in sources (0.2 = consistent but natural wording).
LLM_TEMPERATURE=0.2
CHROMA_PATH=.chroma
PORT=5000
# Cosine-similarity floor for retrieved chunks; below this Luna says it lacks evidence.
MIN_RELEVANCE=0.30
# Optional: a stronger model used only as the RAGAS judge (defaults to LLM_MODEL).
RAGAS_JUDGE_MODEL=
# Parallel RAGAS judge calls; keep low on free API tiers.
RAGAS_MAX_WORKERS=2
